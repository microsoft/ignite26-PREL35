# Deployment outputs written by scripts/env.ps1
APIM_GATEWAY_URL=https://<apim-name>.azure-api.net
APPLICATIONINSIGHTS_CONNECTION_STRING=<application-insights-connection-string>
CANDIDATE_MODEL_DEPLOYMENT=<candidate-model-deployment-name>
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-name>.services.ai.azure.com/api/projects/<project-name>
MODEL_DEPLOYMENT=<model-deployment-name>

# Microsoft Entra values written by scripts/setup-entra-apps.ps1
ENTRA_TENANT_ID=<tenant-id>
APIM_API_APP_OBJECT_ID=<api-app-registration-object-id>
APIM_API_CLIENT_ID=<api-application-client-id>
APIM_API_SERVICE_PRINCIPAL_ID=<api-service-principal-object-id>
APIM_API_AUDIENCE=api://<api-application-client-id>
APIM_API_APP_ROLE_ID=<application-role-id>
APIM_API_APP_ROLE=<application-role-value>
LAB_CLIENT_APP_OBJECT_ID=<confidential-client-app-registration-object-id>
LAB_CLIENT_ID=<confidential-client-application-id>
LAB_CLIENT_SERVICE_PRINCIPAL_ID=<confidential-client-service-principal-object-id>
LAB_CLIENT_SECRET=<client-secret>
