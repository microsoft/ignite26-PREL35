  "variables": {
    "$fxv#0": "<!--\n  Published agents API. Callers send their own Entra ID token; the gateway checks it, limits the caller,\n  then calls Foundry with its own managed identity. The operation name is the agent name.\n-->\n<policies>\n  <inbound>\n    <base />\n    <validate-azure-ad-token tenant-id=\"{{tenant-id}}\" output-token-variable-name=\"jwt\">\n      <audiences>\n        <audience>https://ai.azure.com</audience>\n        <!-- On-Behalf-Of (Lab 2): tokens issued for the gateway's own app registration -->\n        <audience>api://{{obo-client-id}}</audience>\n        <audience>{{obo-client-id}}</audience>\n      </audiences>\n    </validate-azure-ad-token>\n    <rate-limit-by-key calls=\"120\" renewal-period=\"60\"\n                       counter-key=\"@(((Jwt)context.Variables[&quot;jwt&quot;]).Claims.GetValueOrDefault(&quot;oid&quot;, &quot;unknown&quot;))\" />\n    <!-- Token limit (Lab 4): tokens per minute for each caller, set by the token-limit named value. -->\n    <llm-token-limit counter-key=\"@(((Jwt)context.Variables[&quot;jwt&quot;]).Claims.GetValueOrDefault(&quot;oid&quot;, &quot;unknown&quot;))\"\n                     tokens-per-minute=\"{{token-limit}}\" estimate-prompt-tokens=\"false\"\n                     remaining-tokens-header-name=\"x-remaining-tokens\" />\n    <!-- Model routing (Lab 4): when model-routing is \"on\", alerts with a risk score up to routing-max-score go to\n         triage-lite, the same instructions on a smaller model. -->\n    <set-variable name=\"agent\" value=\"@(context.Operation.Id)\" />\n    <choose>\n      <when condition=\"@(&quot;{{model-routing}}&quot; == &quot;on&quot; &amp;&amp; context.Operation.Id == &quot;triage&quot;)\">\n        <set-variable name=\"agent\" value=\"@{\n            try {\n                var input = JObject.Parse((string)context.Request.Body.As<JObject>(preserveContent: true)[&quot;input&quot;]);\n                return (int)input[&quot;alert&quot;][&quot;score&quot;] <= int.Parse(&quot;{{routing-max-score}}&quot;) ? &quot;triage-lite&quot; : &quot;triage&quot;;\n            } catch { return &quot;triage&quot;; }\n        }\" />\n      </when>\n    </choose>\n    <!-- Cost attribution (Lab 4): token use per cost center, caller and agent, sent to Application Insights. -->\n    <llm-emit-token-metric namespace=\"fincrime\">\n      <dimension name=\"Cost center\" value=\"@(context.Request.Headers.GetValueOrDefault(&quot;x-cost-center&quot;, &quot;unassigned&quot;))\" />\n      <dimension name=\"Caller\" value=\"@(((Jwt)context.Variables[&quot;jwt&quot;]).Claims.GetValueOrDefault(&quot;upn&quot;, ((Jwt)context.Variables[&quot;jwt&quot;]).Claims.GetValueOrDefault(&quot;unique_name&quot;, ((Jwt)context.Variables[&quot;jwt&quot;]).Claims.GetValueOrDefault(&quot;appid&quot;, &quot;unknown&quot;))))\" />\n      <dimension name=\"Agent\" value=\"@((string)context.Variables[&quot;agent&quot;])\" />\n    </llm-emit-token-metric>\n    <!-- Prompt Shields (Lab 2): when the prompt-shields named value is \"on\", scan the request for injected\n         instructions before it reaches Foundry. If the scan can't run, the request is refused. -->\n    <choose>\n      <when condition=\"@(\"{{prompt-shields}}\" == \"on\")\">\n        <send-request mode=\"new\" response-variable-name=\"shield\" timeout=\"10\" ignore-error=\"true\">\n          <set-url>{{content-safety-endpoint}}contentsafety/text:shieldPrompt?api-version=2024-09-01</set-url>\n          <set-method>POST</set-method>\n          <set-header name=\"Content-Type\" exists-action=\"override\">\n            <value>application/json</value>\n          </set-header>\n          <set-body>@(new JObject(\n              new JProperty(\"userPrompt\", \"\"),\n              new JProperty(\"documents\", new JArray((context.Request.Body.As<JObject>(preserveContent: true)[\"input\"] ?? \"\").ToString()))\n            ).ToString())</set-body>\n          <authentication-managed-identity resource=\"https://cognitiveservices.azure.com\" />\n        </send-request>\n        <choose>\n          <when condition=\"@(context.Variables[\"shield\"] == null || ((IResponse)context.Variables[\"shield\"]).StatusCode != 200)\">\n            <return-response>\n              <set-status code=\"503\" reason=\"Attack detection unavailable\" />\n              <set-header name=\"Content-Type\" exists-action=\"override\">\n                <value>application/json</value>\n              </set-header>\n              <set-body>{\"error\": {\"code\": \"prompt_shields_unavailable\", \"message\": \"The gateway could not scan this request, so it was refused.\"}}</set-body>\n            </return-response>\n          </when>\n          <when condition=\"@(((IResponse)context.Variables[\"shield\"]).Body.As<JObject>()[\"documentsAnalysis\"].Any(d => (bool)d[\"attackDetected\"]))\">\n            <return-response>\n              <set-status code=\"400\" reason=\"Blocked by gateway\" />\n              <set-header name=\"Content-Type\" exists-action=\"override\">\n                <value>application/json</value>\n              </set-header>\n              <set-body>{\"error\": {\"code\": \"prompt_attack_detected\", \"message\": \"The gateway blocked this request: Prompt Shields detected an injected instruction.\"}}</set-body>\n            </return-response>\n          </when>\n        </choose>\n      </when>\n    </choose>\n    <!-- Whose identity reaches Foundry, set by the caller-identity named value.\n         \"gateway\": the gateway's managed identity, so every caller gets the gateway's rights.\n         \"obo\" (Lab 2): the caller's token is exchanged for one that acts on behalf of the caller,\n         so Foundry applies that person's own permissions. -->\n    <choose>\n      <when condition=\"@(\"{{caller-identity}}\" == \"obo\")\">\n        <send-request mode=\"new\" response-variable-name=\"obo\" timeout=\"10\" ignore-error=\"true\">\n          <set-url>https://login.microsoftonline.com/{{tenant-id}}/oauth2/v2.0/token</set-url>\n          <set-method>POST</set-method>\n          <set-header name=\"Content-Type\" exists-action=\"override\">\n            <value>application/x-www-form-urlencoded</value>\n          </set-header>\n          <set-body>@(\"grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer&requested_token_use=on_behalf_of\"\n              + \"&scope=\" + System.Net.WebUtility.UrlEncode(\"https://ml.azure.com/.default\")\n              + \"&client_id={{obo-client-id}}\"\n              + \"&client_secret=\" + System.Net.WebUtility.UrlEncode(\"{{obo-client-secret}}\")\n              + \"&assertion=\" + context.Request.Headers.GetValueOrDefault(\"Authorization\", \"\").Replace(\"Bearer \", \"\"))</set-body>\n        </send-request>\n        <choose>\n          <when condition=\"@(context.Variables[\"obo\"] == null || ((IResponse)context.Variables[\"obo\"]).StatusCode != 200)\">\n            <return-response>\n              <set-status code=\"401\" reason=\"On-Behalf-Of failed\" />\n              <set-header name=\"Content-Type\" exists-action=\"override\">\n                <value>application/json</value>\n              </set-header>\n              <set-body>@(new JObject(new JProperty(\"error\", new JObject(\n                  new JProperty(\"code\", \"on_behalf_of_failed\"),\n                  new JProperty(\"message\", context.Variables[\"obo\"] == null\n                      ? \"The gateway could not reach Entra ID.\"\n                      : (string)((IResponse)context.Variables[\"obo\"]).Body.As<JObject>()[\"error_description\"])))).ToString())</set-body>\n            </return-response>\n          </when>\n          <otherwise>\n            <set-header name=\"Authorization\" exists-action=\"override\">\n              <value>@(\"Bearer \" + (string)((IResponse)context.Variables[\"obo\"]).Body.As<JObject>()[\"access_token\"])</value>\n            </set-header>\n            <set-variable name=\"foundryCaller\" value=\"@(\"on behalf of \" + ((Jwt)context.Variables[\"jwt\"]).Claims.GetValueOrDefault(\"name\", \"the caller\"))\" />\n          </otherwise>\n        </choose>\n      </when>\n      <otherwise>\n        <authentication-managed-identity resource=\"https://ai.azure.com\" />\n        <set-variable name=\"foundryCaller\" value=\"gateway managed identity\" />\n      </otherwise>\n    </choose>\n    <set-backend-service backend-id=\"foundry-project\" />\n    <rewrite-uri template=\"@(&quot;/agents/&quot; + (string)context.Variables[&quot;agent&quot;] + &quot;/endpoint/protocols/openai/responses&quot;)\" copy-unmatched-params=\"false\" />\n    <set-query-parameter name=\"api-version\" exists-action=\"override\">\n      <value>v1</value>\n    </set-query-parameter>\n  </inbound>\n  <backend>\n    <base />\n  </backend>\n  <outbound>\n    <base />\n    <!-- Shows which agent answered and which identity Foundry saw. -->\n    <set-header name=\"x-agent\" exists-action=\"override\">\n      <value>@((string)context.Variables[\"agent\"])</value>\n    </set-header>\n    <set-header name=\"x-foundry-caller\" exists-action=\"override\">\n      <value>@((string)context.Variables[\"foundryCaller\"])</value>\n    </set-header>\n  </outbound>\n  <on-error>\n    <base />\n  </on-error>\n</policies>\n",
    "token": "[toLower(uniqueString(resourceGroup().id))]",
