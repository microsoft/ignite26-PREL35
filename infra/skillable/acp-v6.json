{
  "if": {
    "anyOf": [
      {
        "not": {
          "anyOf": [
            {
              "field": "type",
              "in": [
                "Microsoft.Resources/deployments",
                "Microsoft.Insights/components",
                "microsoft.alertsmanagement/smartDetectorAlertRules",
                "microsoft.insights/actiongroups",
                "Microsoft.CognitiveServices/accounts/projects",
                "Microsoft.CognitiveServices/accounts/projects/connections",
                "Microsoft.Authorization/roleAssignments",
                "Microsoft.Authorization/policyAssignments"
              ]
            },
            {
              "allOf": [
                { "field": "type", "equals": "Microsoft.OperationalInsights/workspaces" },
                { "field": "name", "like": "log-*" },
                {
                  "anyOf": [
                    { "field": "Microsoft.OperationalInsights/workspaces/sku.name", "exists": false },
                    { "field": "Microsoft.OperationalInsights/workspaces/sku.name", "equals": "PerGB2018" }
                  ]
                }
              ]
            },
            {
              "allOf": [
                { "field": "type", "equals": "Microsoft.CognitiveServices/accounts" },
                { "field": "name", "like": "aif-*" },
                { "field": "kind", "equals": "AIServices" },
                { "field": "Microsoft.CognitiveServices/accounts/sku.name", "equals": "S0" }
              ]
            },
            {
              "allOf": [
                { "field": "type", "equals": "Microsoft.CognitiveServices/accounts/deployments" },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/sku.name", "equals": "GlobalStandard" },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/sku.capacity", "lessOrEquals": 60 },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/model.name", "in": ["gpt-5-mini", "gpt-5-nano"] }
              ]
            },
            {
              "allOf": [
                { "field": "type", "equals": "Microsoft.CognitiveServices/accounts/deployments" },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/sku.name", "equals": "Standard" },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/sku.capacity", "lessOrEquals": 10 },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/model.name", "equals": "text-embedding-3-small" }
              ]
            },
            {
              "allOf": [
                { "field": "type", "equals": "Microsoft.CognitiveServices/accounts/deployments" },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/sku.name", "equals": "DataZoneStandard" },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/sku.capacity", "lessOrEquals": 50 },
                { "field": "Microsoft.CognitiveServices/accounts/deployments/model.name", "equals": "Microsoft-Decision-1.1" }
              ]
            },
            {
              "allOf": [
                { "field": "type", "equals": "Microsoft.Search/searchServices" },
                { "field": "name", "like": "search-*" },
                { "field": "Microsoft.Search/searchServices/sku.name", "equals": "basic" }
              ]
            },
            {
              "allOf": [
                { "field": "type", "equals": "Microsoft.WebIQ/accounts" },
                { "field": "name", "like": "webiq-*" },
                { "field": "kind", "equals": "WebIQ.Grounding" }
              ]
            },
            {
              "allOf": [
                { "field": "type", "equals": "Microsoft.ApiManagement/service" },
                { "field": "name", "like": "apim-*" },
                { "field": "Microsoft.ApiManagement/service/sku.name", "equals": "BasicV2" },
                { "field": "Microsoft.ApiManagement/service/sku.capacity", "lessOrEquals": 1 }
              ]
            },
            { "field": "type", "like": "Microsoft.ApiManagement/service/*" }
          ]
        }
      },
      { "field": "id", "notContains": "[concat('/resourceGroups/', resourceGroup().name, '/')]" },
      {
        "allOf": [
          { "field": "location", "exists": true },
          { "field": "location", "notIn": ["[resourceGroup().location]", "global"] },
          {
            "not": {
              "allOf": [
                { "field": "type", "equals": "Microsoft.Search/searchServices" },
                { "field": "location", "equals": "eastus" }
              ]
            }
          }
        ]
      }
    ]
  },
  "then": { "effect": "deny" }
}
