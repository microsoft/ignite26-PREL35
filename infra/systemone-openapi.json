                    "transactions": [
                      {
                        "amount": 0,
                        "channel": "string",
                        "counterparty": "string",
                        "counterparty_country": "string",
                        "counterparty_type": "string",
                        "currency": "string",
                        "customer_id": "string",
                        "direction": "string",
                        "id": "string",
                        "memo": "string",
                        "timestamp": "string"
                      }
                    ]
                  }
                ],
                "batch_reference": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "N ordered correlated assessments; per-case errors have null dispositions."
          },
          "400": {
            "description": "Invalid batch envelope; no inference."
          }
        }
      }
