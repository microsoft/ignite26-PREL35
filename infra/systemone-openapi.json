    "/asses_next_step": {
      "post": {
        "summary": "Assess 1..50 complete permitted case files with Decision-1",
        "description": "Fixed server-owned bank rules; independent inference per case. Read-only recommendations, not case actions.",
        "operationId": "asses_next_step",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentRequest"
              },
              "example": {
                "cases": [
                  {
                    "alert": {
                      "created": "string",
                      "customer_id": "string",
                      "id": "string",
                      "jurisdiction": "string",
                      "rule": "string",
                      "score": 0,
                      "title": "string"
                    },
                    "customer": {
                      "account_number": "string",
                      "date_of_birth": "string",
                      "expected_monthly_volume": 0,
                      "id": "string",
                      "jurisdiction": "string",
                      "kyc_status": "string",
                      "name": "string",
                      "occupation": "string",
                      "onboarded": "string",
                      "pep": true,
                      "risk_rating": "string",
                      "type": "string"
                    },
                    "documents": [
                      {
                        "amount": 0,
                        "classification": 0,
                        "content": "string",
                        "customer_id": "string",
                        "id": "string",
                        "source": "string",
                        "title": "string",
                        "type": "string",
                        "withheld": "string"
                      }
                    ],
                    "prior_cases": [
                      {
                        "customer_id": "string",
                        "id": "string",
                        "opened": "string",
                        "outcome": "string",
                        "summary": "string"
                      }
                    ],
                    "screening_lists": {
                      "counterparty_kyc": {
                        "Daniel Reyes": {
                          "date_of_birth": "string",
                          "nationality": "string"
                        },
                        "Viktor Salazar-Orlov": {
                          "date_of_birth": "string",
                          "nationality": "string"
                        }
                      },
                      "high_risk_jurisdictions": [
                        {
                          "code": "string",
                          "name": "string"
                        }
                      ],
                      "pep": [
                        {
                          "country": "string",
                          "id": "string",
                          "name": "string",
                          "position": "string"
                        }
                      ],
                      "sanctions": [
                        {
                          "date_of_birth": "string",
                          "id": "string",
                          "name": "string",
                          "nationality": "string",
                          "programme": "string"
                        }
                      ]
